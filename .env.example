# .env.example — DermAI Backend Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Server ────────────────────────────────────────────────────────────────────
APP_NAME="DermAI API"
APP_VERSION="1.0.0"
DEBUG=false

# ── Model ─────────────────────────────────────────────────────────────────────
# Path to the PyTorch checkpoint, relative to the working directory.
MODEL_PATH=DermAI_Mega_Payload.pth

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Maximum image upload size in bytes. Default: 10485760 (10 MB).
MAX_UPLOAD_SIZE_BYTES=10485760

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use ["*"] for open development only.
# Example production value: ["https://yourapp.com","https://www.yourapp.com"]
CORS_ALLOW_ORIGINS=["*"]

# ── LangChain / OpenAI ────────────────────────────────────────────────────────
# Set this to enable real LLM-powered patient explanations.
# Without this key, the RAG engine returns a deterministic mock response.
# OPENAI_API_KEY=sk-...

# LLM model to use for patient explanations. Default: gpt-4o-mini.
LLM_MODEL_NAME=gpt-4o-mini

# Number of context documents retrieved from the vector DB per request.
RAG_TOP_K_DOCUMENTS=3
